# ============================================================
#  Konfigurasi Deteksi Rokok + Alarm WhatsApp (WAHA)
#  Salin file ini menjadi ".env" lalu isi sesuai kebutuhan.
# ============================================================

# --- WAHA (WhatsApp HTTP API) -------------------------------
# URL service WAHA. Default jika dijalankan via Docker di laptop yang sama.
WAHA_URL=http://localhost:3000
# Nama session WAHA (default = "default"). Scan QR di dashboard WAHA
# pada session ini -> nomor yang di-scan = PENGIRIM alarm.
WAHA_SESSION=default

# --- Penerima alarm -----------------------------------------
# Format: kode negara + nomor (tanpa '+'). Pisahkan dengan koma untuk
# banyak penerima.
#   Contoh 1 nomor   : 628123456789
#   Contoh 2 nomor   : 628123456789,628987654321
WA_RECIPIENT=6282253900780

# --- Threshold alarm ----------------------------------------
# Jeda minimum (detik) antar pengiriman alarm "confirm" supaya tidak spam.
# Lebih kecil = lebih realtime utk kejadian beruntun, tapi lebih bising.
ALERT_COOLDOWN_SEC=10
# Jeda alarm "suspect" (DICURIGAI). Biasanya lebih panjang dari confirm
# supaya peringatan ragu-ragu tidak membanjiri WA.
ALERT_SUSPECT_COOLDOWN_SEC=30
# Apakah tier "suspect" boleh mengirim WA? Default: false
# (false = hanya tier "confirm" yg mengirim WA; suspect cuma di-log).
ALERT_SUSPECT_ENABLED=false

# === Ambang 2-tingkat (anti false-positive) =================
# Confidence MINIMUM utk dianggap "dicurigai" (suspect).
# Detection dgn conf < nilai ini diabaikan total (tetap di-overlay
# di video, tapi tidak masuk perhitungan alarm).
ALERT_CONF_SUSPECT=0.45
# Confidence utk alarm penuh (konfirmasi merokok).
# Hanya >= nilai ini yg mengirim "🚨 ALARM DETEKSI MEROKOK".
# Antara SUSPECT..CONFIRM -> dikirim "⚠️ DICURIGAI MEROKOK".
ALERT_CONF_CONFIRM=0.70

# === Temporal confirmation (sliding window) =================
# Deteksi harus muncul minimal ALERT_MIN_HITS frame
# dalam jendela ALERT_WINDOW_SEC detik baru memicu alarm SUSPECT.
# Lebih kecil = lebih cepat trigger, tapi lebih rentan false positive.
ALERT_MIN_HITS=2
ALERT_WINDOW_SEC=2.0

# Min hits KHUSUS utk class confirm (default 1).
# Event "menghisap rokok" itu sangat cepat (sering hanya 1-2 frame
# tertangkap), jadi 1 frame "merokok" dgn conf >= ALERT_CONF_CONFIRM
# (0.70) sudah cukup memicu alarm CONFIRM, meskipun di window yg sama
# class lain (mis. "pegang rokok") muncul lebih dominan.
# False positive dicegah oleh confirm_conf yg tinggi.
ALERT_CONFIRM_MIN_HITS=1

# === Upload snapshot (kecepatan pengiriman WA) ==============
# Resize snapshot ke max width (px) sebelum dikirim. Lebih kecil ->
# upload lebih cepat. 1280 = sweet spot kualitas vs kecepatan.
ALERT_SNAPSHOT_MAX_W=1280
# Kualitas JPEG snapshot 1..100. 75 ~ kualitas bagus dgn ukuran kecil.
ALERT_JPEG_QUALITY=75

# (Legacy) ALERT_CONF_THRESHOLD masih dibaca utk kompatibilitas:
# jika ALERT_CONF_CONFIRM tidak diset, nilai lama ini dipakai.
# ALERT_CONF_THRESHOLD=0.5

# Kelas yang memicu alarm (dipisah koma, lowercase). Sesuai data.yaml.
ALERT_CLASSES=merokok,pegang rokok,dataset-deteksi-merokok

# Subset kelas yang boleh memicu alarm "confirm" (alarm penuh).
# Kelas yg ada di ALERT_CLASSES tapi TIDAK ada di sini akan di-cap
# maksimal "suspect" walaupun confidence tinggi.
# Rasional: "pegang rokok" belum tentu menghisap -> hanya dicurigai.
# "dataset-deteksi-merokok" = orang dgn rokok di mulut -> boleh confirm.
ALERT_CONFIRM_CLASSES=dataset-deteksi-merokok,merokok

# --- Identitas lokasi (opsional, ikut dikirim di pesan) -----
CAMERA_LOCATION=Kamera HP - Ruang Utama

# --- Model & deteksi ----------------------------------------
MODEL_PATH=runs/detect/runs/train/rokok_yolov12/weights/best.pt
DEVICE=auto
IMG_SIZE=640
DEFAULT_CONF=0.25
DEFAULT_IOU=0.45

# --- Sumber kamera (IP Webcam dari HP Android) --------------
# Install app "IP Webcam" di HP -> Start server -> catat URL.
# Endpoint MJPEG biasanya:  http://<ip-hp>:8080/video
# Contoh:
#   VIDEO_SOURCE=http://192.168.1.10:8080/video
# Bisa juga: 0 (webcam laptop), path file .mp4, atau URL RTSP.
VIDEO_SOURCE=http://192.168.1.10:8080/video
